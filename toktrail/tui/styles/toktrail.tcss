Screen {
  layout: vertical;
}

#compact-bar {
  display: none;
  height: 1;
  padding: 0 1;
  color: $text-muted;
}

#content {
  height: 1fr;
  border: round $panel;
}

#dashboard,
#sessions,
#areas,
#prices,
#subscriptions,
#config {
  height: 1fr;
  width: 100%;
}

#sessions,
#areas,
#prices,
#subscriptions {
  layout: vertical;
}

#sessions-table,
#areas-table,
#subscriptions-table,
#prices-configured-table,
#prices-unconfigured-table {
  height: 1fr;
}

#sessions-detail,
#areas-detail,
#subscriptions-detail,
#prices-detail {
  height: auto;
  border-top: heavy $panel;
  padding: 0 1;
}


#session-detail-scroll {
  height: 1fr;
  width: 100%;
  padding: 0 1;
}

#session-detail-content {
  width: 100%;
}
#status {
  height: auto;
  padding: 0 1;
  color: $text-muted;
}

#price-error {
  color: $error;
}

Screen.compact Header,
Screen.micro Header {
  display: none;
}

Screen.compact Footer,
Screen.micro Footer {
  display: none;
}

Screen.compact Tabs,
Screen.micro Tabs {
  display: none;
}

Screen.compact #compact-bar,
Screen.micro #compact-bar {
  display: block;
}

Screen.compact #content,
Screen.micro #content {
  border: none;
}

Screen.compact.compact-details-hidden #sessions-detail,
Screen.compact.compact-details-hidden #areas-detail,
Screen.compact.compact-details-hidden #subscriptions-detail,
Screen.compact.compact-details-hidden #prices-detail {
  display: none;
}

Screen.compact #sessions-detail,
Screen.compact #areas-detail,
Screen.compact #subscriptions-detail,
Screen.compact #prices-detail {
  height: 6;
}

Screen.micro #sessions-detail,
Screen.micro #areas-detail,
Screen.micro #subscriptions-detail,
Screen.micro #prices-detail {
  display: none;
}

Screen.compact #status,
Screen.micro #status {
  height: 1;
  padding: 0 1;
}
